#!/usr/bin/env bash
# Ana quick launcher: bring up the waifu overlay (only if it is not
# already running) and open the chat TUI in the default terminal.
# Bound to Meta+A in KDE Plasma (System Settings → Shortcuts, command
# "Ana — Abrir", S15/T33); in Hyprland the same script binds via
# ~/.config/hypr/bindings.lua, and in labwc/Niri via their own config.
#
# Single overlay instance matters: two FIFO readers would split every
# say/state event between them and the subtitle would flicker randomly.
set -u

# kglobalaccel launches this from kwin_wayland, whose PATH has no
# ~/.local/bin — where the voxtype STT engine lives. Prepend it so the
# TUI voice rounds work no matter who starts us.
PATH="$HOME/.local/bin:$PATH"
export PATH

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANA="$REPO/.venv/bin/ana"

# Match the live overlay only: the re-exec'd system-python process
# ("python3 -m ana.overlay waifu") and the pre-re-exec venv one
# (".../.venv/bin/ana waifu"). Anchored so wrapper shells that merely
# CONTAIN those words (bash -c '... ana waifu ...') never count.
if ! pgrep -f '^python3 -m ana\.overlay|bin/ana waifu$' >/dev/null 2>&1; then
    # detached: survives the exec below; log for post-mortems
    (nohup "$ANA" waifu >/tmp/ana-waifu.log 2>&1 </dev/null &)
fi

# replace this process with the terminal running the TUI.
# xdg-terminal-exec first (any desktop with xdg-utils), then a known
# terminal: fresh installs (Void/labwc) often lack xdg-terminal-exec.
launch_term() {
    # $1 = binary, rest = argv prefix that must end with "$ANA" tui
    local bin="$1"; shift
    exec "$bin" "$@" "$ANA" tui
}
if command -v xdg-terminal-exec >/dev/null 2>&1; then
    exec xdg-terminal-exec "$ANA" tui
fi
for term in foot alacritty kitty ghostty wezterm xterm; do
    if command -v "$term" >/dev/null 2>&1; then
        launch_term "$term"
    fi
done
# argv-style terminals (each needs its own separator flag)
if command -v gnome-terminal >/dev/null 2>&1; then
    launch_term gnome-terminal --
elif command -v konsole >/dev/null 2>&1; then
    launch_term konsole -e
fi

echo "ana-quick: no terminal emulator found (install xdg-utils or one of: foot, alacritty, kitty, ghostty, wezterm, konsole)" >&2
exit 127
